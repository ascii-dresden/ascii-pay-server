         "const jsonResponse = pm.response.json();",
         "",
         "pm.test(\"Status test\", function () {",
         "    pm.response.to.have.status(200);",
         "});",
         "",
         "pm.test(\"Both variants of one product\", function () {",
         "    pm.expect(jsonResponse.id).to.eql(pm.globals.get(\"product_id\"));",
         "    pm.expect(jsonResponse.barcodes.length).to.eql(2);",
         "    pm.expect(jsonResponse.barcodes[1].container_size).to.eql(20);",
         "    pm.expect(jsonResponse.barcode).to.eql(\"4260000000001\");",
         "});"
        ],
