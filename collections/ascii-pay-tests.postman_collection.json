    {
     "name": "Create product",
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "const jsonResponse = pm.response.json();",
         "pm.globals.set(\"product_id\", jsonResponse.id);",
         "",
         "pm.test(\"Status test\", function () {",
         "    pm.response.to.have.status(200);",
         "});",
         "",
         "pm.test(\"Barcode stored\", function () {",
         "    pm.expect(jsonResponse.barcodes.length).to.eql(1);",
         "    pm.expect(jsonResponse.barcodes[0].code).to.eql(\"4260000000001\");",
         "    pm.expect(jsonResponse.barcodes[0].container_size).to.eql(1);",
         "    pm.expect(jsonResponse.barcode).to.eql(\"4260000000001\");",
         "});"
        ],
        "type": "text/javascript"
       }
      }
     ],
     "request": {
      "method": "POST",
      "header": [],
      "body": {
       "mode": "raw",
       "raw": "{\n    \"name\": \"Cofe\",\n    \"price\": {\n        \"Cent\": 140,\n        \"CoffeeStamp\": 10\n    },\n    \"bonus\": {\n        \"CoffeeStamp\": 1\n    },\n    \"nickname\": \"C\",\n    \"purchase_tax\": 19,\n    \"category\": \"Hot\",\n    \"print_lists\": [],\n    \"tags\": [\n        \"Vegan\"\n    ],\n    \"status_prices\": [],\n    \"barcodes\": [\n        {\n            \"code\": \"4260000000001\",\n            \"container_size\": 1,\n            \"label\": \"Einzelflasche\"\n        }\n    ]\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      },
